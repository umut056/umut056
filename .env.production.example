VITE_APP_ENV=production
VITE_ENABLE_DEMO_ACCOUNTS=false

# Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_MEDIA_BUCKET=stepwise-media

# Firebase web push key. Native Android FCM uses google-services.json.
VITE_FCM_VAPID_KEY=your-firebase-vapid-key

# Optional fallback if Cloudinary is later preferred for public media workflows.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
